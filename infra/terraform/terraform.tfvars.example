# Copy to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars — it contains secrets.
# .gitignore already includes *.tfvars

project_id  = "your-gcp-project-id"
region      = "us-central1"
zone        = "us-central1-a"
environment = "prod"

# Database
db_tier     = "db-g1-small"   # upgrade to db-n1-standard-2 for prod
db_name     = "neuralgcm_weather"
db_user     = "neuralgcm"
db_password = "change-this-to-a-strong-password"

# Redis
redis_tier      = "BASIC"
redis_memory_gb = 1

# GKE
gke_node_count   = 2
gke_machine_type = "n1-standard-4"
gpu_type         = "nvidia-tesla-t4"
gpu_count        = 1

# Docker images
image_tag = "latest"

# Alerting
alert_email = "your-email@company.com"
