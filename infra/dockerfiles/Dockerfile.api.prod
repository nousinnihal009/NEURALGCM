# Multi-stage build: smaller final image, faster pulls
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev libeccodes-dev curl && \
    rm -rf /var/lib/apt/lists/*

# Copy and install Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ── Runtime stage ─────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /root/.local /root/.local

# Runtime system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 libeccodes0 curl && \
    rm -rf /var/lib/apt/lists/*

# App source
COPY neuralgcm_weather/ ./neuralgcm_weather/
COPY api/ ./api/
COPY config.yaml .
COPY alembic/ ./alembic/
COPY alembic.ini .

# Non-root user for security
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

ENV PATH="/root/.local/bin:$PATH"
ENV PYTHONPATH="/app"
# GPU not needed for API — API server only handles routing
ENV JAX_PLATFORMS="cpu"
ENV XLA_PYTHON_CLIENT_PREALLOCATE="false"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Run migrations then start with Gunicorn (more robust than uvicorn alone)
CMD ["sh", "-c", \
     "alembic upgrade head && \
      gunicorn api.main:app \
        --workers 2 \
        --worker-class uvicorn.workers.UvicornWorker \
        --bind 0.0.0.0:8000 \
        --timeout 120 \
        --graceful-timeout 30 \
        --keep-alive 5 \
        --access-logfile - \
        --error-logfile -"]
