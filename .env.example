# App
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-in-production

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=neuralgcm_weather
POSTGRES_USER=neuralgcm
POSTGRES_PASSWORD=neuralgcm_dev_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# NeuralGCM
NEURALGCM_MODEL=v1/deterministic_2_8_deg.pkl
NEURALGCM_CACHE_DIR=./cache

# ECMWF
ECMWF_LAG_HOURS=6
