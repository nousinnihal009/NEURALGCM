# NeuralGCM Weather — Environment Variables
# Copy to .env and fill in values as needed

# ECMWF API key (optional, for authenticated access)
# ECMWF_API_KEY=your_key_here
# ECMWF_API_URL=https://api.ecmwf.int/v1

# JAX settings (defaults set in code, override if needed)
# JAX_PLATFORMS=cpu
# XLA_FLAGS=--xla_cpu_use_thunk_runtime=false
