FROM python:3.11-slim AS base

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc libeccodes-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY neuralgcm_weather/ ./neuralgcm_weather/
COPY api/ ./api/
COPY config.yaml .

ENV JAX_PLATFORMS=cpu
ENV XLA_PYTHON_CLIENT_PREALLOCATE=false


FROM base AS production
CMD ["celery", "-A", "api.worker.celery_app", "worker", \
     "--loglevel=info", "--concurrency=2", "--max-tasks-per-child=10"]


FROM base AS dev
CMD ["celery", "-A", "api.worker.celery_app", "worker", \
     "--loglevel=debug", "--concurrency=1", "--max-tasks-per-child=10"]
